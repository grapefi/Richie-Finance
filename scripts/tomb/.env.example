# Merge these settings into C:\repo\.env. Never replace your existing .env blindly.
# Set a FUTURE Unix timestamp before deploying; see README.md.
TOMB_START_TIME=
TOMB_COMMUNITY_FUND=
TOMB_DEV_FUND=

# Save addresses printed by each deployment before continuing.
TOMB_PEG_ADDRESS=
TOMB_SHARE_ADDRESS=
TOMB_GENESIS_ADDRESS=
TOMB_FARM_ADDRESS=
TOMB_BOARDROOM_ADDRESS=
TOMB_TREASURY_ADDRESS=
TOMB_ORACLE_ADDRESS=
TOMB_SHARE_ORACLE_ADDRESS=
TOMB_REDEEM_ADDRESS=
TOMB_REBATES_ADDRESS=
TOMB_ZAP_ADDRESS=

# Liquidity pairs must already exist and contain reserves.
TOMB_PAIR_ADDRESS=
TOMB_ORACLE_PERIOD=21600
TOMB_ORACLE_START_TIME=
TOMB_SHARE_PAIR_ADDRESS=
TOMB_SHARE_ORACLE_PERIOD=3600
TOMB_SHARE_ORACLE_START_TIME=
TOMB_PEG_PDAI_PAIR_ADDRESS=
TOMB_FARM_START_TIME=

# JSON arrays. Replace token addresses with actual contracts; large numbers use strings.
TOMB_GENESIS_POOLS=
TOMB_GENESIS_FEE_RECIPIENT=
TOMB_FARM_POOLS=
TOMB_PSM_ENABLED=false
TOMB_PSM_FEE_BPS=1500
TOMB_PSM_MAX_ORACLE_AGE=7200
TOMB_PSM_FEE_RECIPIENT=
TOMB_MIN_CLAIM_THRESHOLD=1000000000000

# Optional Treasury settings: leave empty to preserve contract defaults/current values.
TOMB_DAO_FUND=
TOMB_DAO_FUND_BPS=
TOMB_TREASURY_DEV_FUND=
TOMB_TREASURY_DEV_FUND_BPS=
TOMB_PEG_PRICE_CEILING=
TOMB_MAX_SUPPLY_EXPANSION_BPS=
TOMB_BOOTSTRAP_EPOCHS=
TOMB_BOOTSTRAP_EXPANSION_BPS=
TOMB_BOARDROOM_WITHDRAW_LOCKUP_EPOCHS=
TOMB_BOARDROOM_REWARD_LOCKUP_EPOCHS=

# PDAI defaults to canonical PulseChain DAI. Reserve amounts are raw token units.
TOMB_PDAI_ADDRESS=0x6B175474E89094C44Da98b954EedeAC495271d0F
TOMB_REDEEM_PDAI_RESERVE_WEI=0

# Rebates are optional and funded SEPARATELY from farm emissions.
# Asset and SHARE oracles must use the SAME quote currency.
# Rebate quote MUST be bridged USDC, not the farm's WPLS quote.
TOMB_REBATE_SHARE_PAIR_ADDRESS=
TOMB_REBATE_ORACLE_PERIOD=3600
TOMB_REBATE_ORACLE_START_TIME=
TOMB_REBATE_MAX_ORACLE_AGE=86400
TOMB_REBATE_SHARE_ORACLE_ADDRESS=
TOMB_REBATE_ASSETS=
TOMB_REBATE_DISCOUNT=70000
TOMB_REBATE_VESTING_SECONDS=259200
TOMB_REBATE_SHARE_RESERVE_WEI=0

# Optional native PLS / WPLS rebates. Leave ENABLED blank to preserve current settings.
TOMB_REBATE_PLS_ENABLED=
TOMB_REBATE_PLS_PAIR_ADDRESS=
TOMB_REBATE_PLS_ORACLE_ADDRESS=
TOMB_REBATE_PLS_ORACLE_PERIOD=3600
TOMB_REBATE_PLS_ORACLE_START_TIME=
TOMB_REBATE_PLS_MULTIPLIER=1000000

# Explicit final administration transfer; no script transfers to this automatically.
TOMB_ADMIN_ADDRESS=
